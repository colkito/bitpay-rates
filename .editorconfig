# Editor hints only. Biome (biome.json) is the formatter that CI and the
# pre-commit hook enforce for .mts/.mjs; keep the two in sync if you change
# either. This file also covers the files Biome does not format (yml, md).
# editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
max_line_length = 100
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
