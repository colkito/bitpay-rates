{
  "compilerOptions": {
    "target": "es2023",
    "module": "node20",
    "moduleResolution": "node16",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.mts", "scripts/**/*.mts", "tsdown.config.mts"]
}
