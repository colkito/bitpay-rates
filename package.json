{
  "name": "bitpay-rates",
  "version": "3.0.0",
  "description": "A tiny Node.js wrapper for the BitPay Rates API",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bitcoin",
    "bitpay",
    "rates",
    "countries",
    "price"
  ],
  "author": "Mario Colque <dev@colkito.com>",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colkito/bitpay-rates.git"
  },
  "bugs": {
    "url": "https://github.com/colkito/bitpay-rates/issues"
  },
  "homepage": "https://github.com/colkito/bitpay-rates#readme",
  "scripts": {
    "test": "tsx --test src/index.test.ts",
    "test:watch": "tsx --test --watch src/index.test.ts",
    "lint": "tsc --noEmit && biome check",
    "format": "biome check --write",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "22.19.21",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/**/*"
  ]
}
