{
  "name": "bitpay-rates",
  "version": "3.0.0",
  "description": "A tiny Node.js wrapper for the BitPay Rates API",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bitcoin",
    "bitpay",
    "rates",
    "countries",
    "price"
  ],
  "author": "Mario Colque <dev@colkito.com>",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colkito/bitpay-rates.git"
  },
  "bugs": {
    "url": "https://github.com/colkito/bitpay-rates/issues"
  },
  "homepage": "https://github.com/colkito/bitpay-rates#readme",
  "scripts": {
    "test": "tsx --test src/index.test.ts",
    "test:watch": "tsx --test --watch src/index.test.ts",
    "lint": "tsc --noEmit && biome check",
    "format": "biome check --write",
    "build": "tsup",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "preversion": "npm run lint",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist/**/*"
  ]
}
