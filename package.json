{
  "name": "bitpay-rates",
  "version": "2.0.0",
  "description": "A tiny Node.js wrapper for the BitPay Rates API",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bitcoin",
    "bitpay",
    "rates",
    "countries",
    "price"
  ],
  "author": "Mario Colque <dev@colkito.com>",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colkito/bitpay-rates.git"
  },
  "bugs": {
    "url": "https://github.com/colkito/bitpay-rates/issues"
  },
  "homepage": "https://github.com/colkito/bitpay-rates#readme",
  "scripts": {
    "test": "node --test src/index.test.mts scripts/codes-markdown.test.mts",
    "test:watch": "node --test --watch src/index.test.mts scripts/codes-markdown.test.mts",
    "test:coverage": "node --test --experimental-test-coverage src/index.test.mts scripts/codes-markdown.test.mts",
    "lint": "tsc --noEmit && biome check",
    "format": "biome check --write",
    "build": "tsdown",
    "knip": "knip",
    "update-codes": "node scripts/update-codes.mts",
    "prepare": "lefthook install",
    "prepublishOnly": "npm run build"
  },
  "knip": {
    "rules": {
      "duplicates": "off"
    },
    "ignore": [
      "example/**"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "22.19.21",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "allowScripts": {
    "lefthook@2.1.12": true
  }
}
